{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<style>
    body {
        background: #f2f2f5; /* gris clair */
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
        animation: fadeInBg 1s ease;
    }

    @keyframes fadeInBg {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    h1 {
        text-align: center;
        color: #d991c3; /* rose bébé */
        margin-bottom: 5px;
        animation: slideDown 0.8s ease;
    }

    p {
        text-align: center;
        color: #6c757d;
        margin-bottom: 30px;
    }

    @keyframes slideDown {
        from { transform: translateY(-20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .row-cols-1 .col, .row-cols-md-3 .col {
        animation: fadeUp 1s ease forwards;
        opacity: 0;
    }

    @keyframes fadeUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .card {
        border-radius: 20px;
        box-shadow: 0 12px 25px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #ffffff; /* blanc */
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 35px rgba(0,0,0,0.18);
    }

    .card-title {
        color: #d991c3; /* rose bébé */
        font-weight: 600;
    }

    .card-text {
        color: #6c757d;
    }

    .btn {
        border-radius: 25px;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: #f5c6e0;
        border: none;
        color: #fff;
    }
    .btn-primary:hover {
        background: #e29acb;
    }

    .btn-warning {
        background: #ffc9e3;
        border: none;
        color: #fff;
    }
    .btn-warning:hover {
        background: #f3a3d0;
    }

    .btn-info {
        background: #d3b3e6;
        border: none;
        color: #fff;
    }
    .btn-info:hover {
        background: #b78bd4;
    }

    .btn-danger {
        background: #f08fc4;
        border: none;
        color: #fff;
    }
    .btn-danger:hover {
        background: #d770aa;
    }

    /* Animation séquentielle pour les cartes */
    .row .col:nth-child(1) { animation-delay: 0.1s; }
    .row .col:nth-child(2) { animation-delay: 0.3s; }
    .row .col:nth-child(3) { animation-delay: 0.5s; }
    .row .col:nth-child(4) { animation-delay: 0.7s; }
</style>

<h1>Tableau de bord</h1>
<p>Bienvenue {{ app.user.prenom }} !</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Livres</h5>
                <p class="card-text">Parcourir la bibliothèque.</p>
                <a href="{{ path('app_livre_index') }}" class="btn btn-primary">Voir les livres</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Mes Emprunts</h5>
                <p class="card-text">Gérer vos emprunts en cours.</p>
                <a href="{{ path('app_emprunt_index') }}" class="btn btn-warning">Mes Emprunts</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Mes Réservations</h5>
                <p class="card-text">Suivre vos réservations.</p>
                <a href="{{ path('app_reservation_index') }}" class="btn btn-info">Mes Réservations</a>
            </div>
        </div>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <div class="col">
        <div class="card h-100 border-danger">
            <div class="card-body">
                <h5 class="card-title">Administration</h5>
                <p class="card-text">Gérer les utilisateurs et le contenu.</p>
                <a href="{{ path('app_user_index') }}" class="btn btn-danger">Gérer Users</a>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
