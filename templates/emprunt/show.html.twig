{% extends 'base.html.twig' %}

{% block title %}Emprunt{% endblock %}

{% block body %}
<div class="container my-5" style="background: linear-gradient(to right, #fff4e6, #ffe5b4); padding: 30px; border-radius: 12px;">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Card principale -->
            <div class="card shadow-lg border-0" style="background-color: #fff1e0cc; border-radius: 12px;">
                <div class="card-header" style="background-color: #ff8c42; color: white; text-align: center; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h2 class="mb-0">Détails de l'Emprunt 📖</h2>
                </div>

                <div class="card-body">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th>Id</th>
                                <td>{{ emprunt.id }}</td>
                            </tr>
                            <tr>
                                <th>Date Emprunt</th>
                                <td>{{ emprunt.dateEmprunt ? emprunt.dateEmprunt|date('d/m/Y H:i') : '' }}</td>
                            </tr>
                            <tr>
                                <th>Date Retour Prévue</th>
                                <td>{{ emprunt.dateRetourPrevue ? emprunt.dateRetourPrevue|date('d/m/Y H:i') : '' }}</td>
                            </tr>
                            <tr>
                                <th>Date Retour Effective</th>
                                <td>{{ emprunt.dateRetourEffective ? emprunt.dateRetourEffective|date('d/m/Y H:i') : '' }}</td>
                            </tr>
                            <tr>
                                <th>Statut</th>
                                <td>{{ emprunt.statut }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="card-footer d-flex flex-column gap-2">
                    <a href="{{ path('app_emprunt_index') }}" class="btn  d-block mx-auto" style="background-color: #d2a679; color: white; width: 200px;">
                        <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                    </a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_emprunt_edit', {'id': emprunt.id}) }}"
                        class="btn d-block mx-auto"
                        style="background-color: #d37439; color: white; width: 200px;">
                            <i class="bi bi-pencil-square"></i> Modifier
                        </a>

                        {{ include('emprunt/_delete_form.html.twig') }}
                    {% endif %}

                    
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
